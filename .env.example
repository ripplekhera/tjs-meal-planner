POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://harvest:changeme@localhost:5432/harvest_db

# Login: comma-separated username:password pairs (passwords can't contain commas).
# Required in production; leave unset to skip login during `next dev`.
# AUTH_USERS=alice:change-this-password,bob:change-this-too
# Random string, 32+ characters, used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# AUTH_SECRET=

# Plan generation (the Generate button and `npm run meal-plan:generate-draft`).
# Leave unset to disable it; everything else works without it.
# ANTHROPIC_API_KEY=
